(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r55_20
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 20000)
            (height 55000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r125_75
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 75000)
            (height 125000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r55_20
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r55_20))
          (noconnect (pad r55_20))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r55_20))
          (noconnect (pad r55_20))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r55_20))
          (noconnect (pad r55_20))
        )
      )
      (padstack r125_75
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r125_75))
          (noconnect (pad r125_75))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r125_75))
          (noconnect (pad r125_75))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r125_75))
          (noconnect (pad r125_75))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "SON40P150X150X55-9N"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 135000 102500)
                    (pt 135000 -102500)
                    (pt -135000 -102500)
                    (pt -135000 102500)
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -75000 75000
                        (width 10000)
                      )
                      (pt 75000 75000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 75000 75000
                        (width 10000)
                      )
                      (pt 75000 -75000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 75000 -75000
                        (width 10000)
                      )
                      (pt -75000 -75000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -75000 -75000
                        (width 10000)
                      )
                      (pt -75000 75000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -75000 37500
                        (width 10000)
                      )
                      (pt -37500 75000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 12500)
                        (begin
                          (pt -112500 132500
                            (width 25000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -112500 132500
                            (width 25000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -85000 60000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -85000 60000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 2
            (pt -85000 20000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -85000 20000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 3
            (pt -85000 -20000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -85000 -20000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 4
            (pt -85000 -60000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -85000 -60000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 5
            (pt 85000 -60000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 85000 -60000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 6
            (pt 85000 -20000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 85000 -20000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 7
            (pt 85000 20000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 85000 20000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 8
            (pt 85000 60000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 85000 60000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 9
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 0)
                  (padstackGroup default (padstack r125_75))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape KTD2026EWE-TR.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

