                        (width 10000)
                      )
                      (pt -37500 75000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 12500)
                        (begin
                          (pt -112500 132500
                            (width 25000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -112500 132500
                            (width 25000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -85000 60000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -85000 60000)
                  (angle 90)
                  (padstackGroup default (padstack r55_20))
                )
              )
            )
          )
          (pin 2
            (pt -85000 20000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -85000 20000)
