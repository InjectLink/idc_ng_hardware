        (cuser "SamacSys")
        (uuser "SamacSys")
        (utime 2023-06-21-15:30:09)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Top_Assembly)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -50000 -30000
                        (width 10000)
                      )
                      (pt 50000 -30000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Top_Assembly)
